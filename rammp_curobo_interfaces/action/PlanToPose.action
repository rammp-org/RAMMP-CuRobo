# Plan a collision-free trajectory to a tool_frame pose in the base frame.
# Planning only — nothing moves. Execute the result via ExecuteTrajectory.
geometry_msgs/Pose target
# optional: plan from these joints instead of the live state (rad,
# joint_1..7; empty = live). Enables pre-planning chained segments.
float64[] start_joints
---
bool success
string message                              # failure explanation when !success
trajectory_msgs/JointTrajectory trajectory  # time-parameterized at full speed
float64 planning_time                       # seconds
---
string state
