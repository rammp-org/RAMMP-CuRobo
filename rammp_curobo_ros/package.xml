<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rammp_curobo_ros</name>
  <version>0.1.0</version>
  <description>Thin ROS 2 wrapper around the rammp_curobo planning core:
    plan/execute action servers and a safety-gated FollowJointTrajectory
    executor for the Kinova Gen3 (MuJoCo sim or ros2_kortex, same names).
    Needs the rammp-curobo pip package + pinned cuRobo stack (see README).</description>
  <maintainer email="chrisman4247@gmail.com">RAMMP</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rammp_curobo_interfaces</depend>
  <depend>trajectory_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>control_msgs</depend>
  <depend>std_srvs</depend>
  <depend>builtin_interfaces</depend>
  <depend>controller_manager_msgs</depend>
  <!-- servoing-recovery fault reset (kortex fault_controller's Trigger) -->
  <exec_depend>example_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
